<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.light-mode-manager" path="/org/gnome/shell/extensions/light-mode-manager/">
    <!-- Light mode -->
    <key name="color-general" type="s"><default>'#fafafb'</default><summary>General background (top bar, menus and dialogs, OSD and switcher, overview)</summary></key>
    <key name="color-panel-text" type="s"><default>''</default><summary>Top bar text (empty = same as text color)</summary></key>
    <key name="color-fg" type="s"><default>'#222226'</default><summary>Text and icons</summary></key>
    <key name="color-fg-muted" type="s"><default>'#767679'</default><summary>Secondary text</summary></key>
    <key name="color-card" type="s"><default>'#e8e8e8'</default><summary>Cards</summary></key>
    <key name="color-dash" type="s"><default>'#cecece'</default><summary>Dash, search and folders</summary></key>
    <!-- Dark mode (empty = system default) -->
    <key name="color-general-dark" type="s"><default>'#222226'</default><summary>General background</summary></key>
    <key name="color-panel-text-dark" type="s"><default>''</default><summary>Top bar text</summary></key>
    <key name="color-fg-dark" type="s"><default>''</default><summary>Text and icons</summary></key>
    <key name="color-fg-muted-dark" type="s"><default>''</default><summary>Secondary text</summary></key>
    <key name="color-card-dark" type="s"><default>''</default><summary>Cards</summary></key>
    <key name="color-dash-dark" type="s"><default>''</default><summary>Dash, search and folders</summary></key>
  </schema>
</schemalist>
