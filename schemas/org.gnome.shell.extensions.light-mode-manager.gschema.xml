<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.light-mode-manager" path="/org/gnome/shell/extensions/light-mode-manager/">
    <!-- Light mode (empty = system default) -->
    <key name="color-general" type="s"><default>'#fafafb'</default><summary>General background (top bar, menus and dialogs, OSD and switcher, overview)</summary></key>
    <key name="color-fg" type="s"><default>'#000000'</default><summary>Text and icons</summary></key>
    <key name="color-fg-muted" type="s"><default>'#77767b'</default><summary>Secondary text</summary></key>
    <key name="color-card" type="s"><default>'#ebebed'</default><summary>Cards, dash and search</summary></key>
    <key name="color-border" type="s"><default>'#e3e3e3'</default><summary>Menu borders</summary></key>
    <!-- Dark mode (empty = system default) -->
    <key name="color-general-dark" type="s"><default>'#222226'</default><summary>General background</summary></key>
    <key name="color-fg-dark" type="s"><default>'#ffffff'</default><summary>Text and icons</summary></key>
    <key name="color-fg-muted-dark" type="s"><default>'#c0bfbc'</default><summary>Secondary text</summary></key>
    <key name="color-card-dark" type="s"><default>'#343437'</default><summary>Cards, dash and search</summary></key>
    <key name="color-border-dark" type="s"><default>'#424247'</default><summary>Menu borders</summary></key>
    <!-- Saved color profiles: JSON list of {"name": ..., "colors": {row: color}} -->
    <key name="profiles" type="s"><default>'[]'</default><summary>Light mode profiles</summary></key>
    <key name="profiles-dark" type="s"><default>'[]'</default><summary>Dark mode profiles</summary></key>
    <key name="active-profile" type="s"><default>'Default'</default><summary>Last applied light mode profile</summary></key>
    <key name="active-profile-dark" type="s"><default>'Default'</default><summary>Last applied dark mode profile</summary></key>
    <!-- General profiles: JSON list of {"name": ..., "light": profile name, "dark": profile name} -->
    <key name="general-profiles" type="s"><default>'[]'</default><summary>General profiles</summary></key>
    <key name="active-general-profile" type="s"><default>'Default'</default><summary>Last applied general profile</summary></key>
    <!-- General tab -->
    <key name="transition-duration" type="i"><range min="0" max="2000"/><default>500</default><summary>Fade duration in ms when switching between light and dark mode</summary></key>
    <key name="border-opacity" type="i"><range min="0" max="100"/><default>100</default><summary>Menu border opacity in percent, both modes</summary></key>
    <key name="border-follow-opacity" type="b"><default>false</default><summary>Menu border opacity follows the general background opacity</summary></key>
    <key name="match-arrow-buttons" type="b"><default>false</default><summary>Quick Settings arrow buttons use the same color as their toggle</summary></key>
    <key name="general-opacity" type="i"><range min="0" max="100"/><default>100</default><summary>General background opacity in percent, both modes</summary></key>
    <!-- Automatic switch: apply a general profile at two times of day (minutes since midnight) -->
    <key name="auto-switch" type="b"><default>false</default><summary>Apply general profiles automatically at set times</summary></key>
    <key name="auto-switch-1-time" type="i"><range min="0" max="1439"/><default>420</default><summary>Time of the first switch</summary></key>
    <key name="auto-switch-1-profile" type="s"><default>'Default'</default><summary>General profile applied at the first switch</summary></key>
    <key name="auto-switch-2-time" type="i"><range min="0" max="1439"/><default>1140</default><summary>Time of the second switch</summary></key>
    <key name="auto-switch-2-profile" type="s"><default>'Default'</default><summary>General profile applied at the second switch</summary></key>
    <key name="quick-settings-profiles" type="b"><default>false</default><summary>Show a general profile switcher in Quick Settings</summary></key>
    <key name="panel-menu-entry" type="b"><default>false</default><summary>Add "Light Mode Manager" to the Dash to Panel right-click menu</summary></key>
  </schema>
</schemalist>
